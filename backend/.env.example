# Environment Configuration
# Copy this file to .env and fill in your values

# Gemini API Key (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommendation Mode: AI or RULE
# AI: Uses Gemini for personalized recommendations
# RULE: Uses traditional rule-based logic
RECOMMENDATION_MODE=RULE

# Email Configuration (SMTP - Local Development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Email Configuration (Resend API - Production/Railway)
RESEND_API_KEY=re_123456789

# JWT Secret
JWT_SECRET=your_super_secret_key_change_this_for_production
